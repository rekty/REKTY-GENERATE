{
  "hosting": {
    "public": ".",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "firebase-backend/**",
      "firebase.json",
      "DEPLOY.md",
      "AGENTS.md",
      "agent.md.txt"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "asia-southeast2",
          "pinTag": true
        }
      }
    ]
  },
  "functions": {
    "source": "firebase-backend"
  }
}
